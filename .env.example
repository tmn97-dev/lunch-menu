# Copy to .env.local and fill in. Used by Vercel CLI for local dev.
# On Vercel (deployed), set these in Dashboard → Project → Settings → Environment Variables.

# Google Gemini (free tier) — image → menu JSON. Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Turso (libSQL) — `turso db show <name> --url` and `turso db tokens create <name>`
TURSO_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=

# Random 32+ byte hex string used to sign session JWTs. Generate: `openssl rand -hex 32`
SESSION_SECRET=
